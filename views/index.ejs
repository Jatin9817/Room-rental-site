<!DOCTYPE html>
<html>
<head>
    <title>House Rental</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="container mt-5">
    <div class="d-flex justify-content-between">
        <h1>Available Houses</h1>
        <a href="/register" class="btn btn-primary">Register Your House</a>
    </div>
    <br>
    <div class="row">
        <% for (let house of allListings) { %>
            <div class="col-md-4 mb-4">
                <div class="card">
                    <img src="<%= house.image %>" class="card-img-top" alt="house">
                    <div class="card-body">
                        <h5 class="card-title"><%= house.title %></h5>
                        <p class="card-text"><%= house.location %> • <b>$<%= house.price %></b></p>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</body>
</html>