<!DOCTYPE html>
<html>
<head>
    <title>Register House</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="container mt-5">
    <h2>List Your Property</h2>
    <form action="/register" method="POST" class="col-md-6">
        <div class="mb-3">
            <label>House Title</label>
            <input type="text" name="title" class="form-control" placeholder="e.g. Cozy Beach Villa" required>
        </div>
        <div class="mb-3">
            <label>Image URL</label>
            <input type="text" name="image" class="form-control" placeholder="Link to photo" required>
        </div>
        <div class="mb-3">
            <label>Price per Night</label>
            <input type="number" name="price" class="form-control" required>
        </div>
        <div class="mb-3">
            <label>Location</label>
            <input type="text" name="location" class="form-control" required>
        </div>
        <button class="btn btn-success">Submit Listing</button>
        <a href="/" class="btn btn-link">Back to Home</a>
    </form>
</body>
</html>